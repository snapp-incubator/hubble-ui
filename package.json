{
  "name": "hubble-ui",
  "private": true,
  "scripts": {
    "test": "jest",
    "postinstall": "patch-package && bash ./scripts/post-install.sh",
    "watch:server": "servor ./server/public index.html 8080",
    "watch:client": "NODE_ENV=development webpack --progress",
    "watch": "run-p watch:*",
    "build": "NODE_ENV=production webpack",
    "prettier": "prettier --write .",
    "lint": "run-s lint:ts lint:scss",
    "lint:fix": "run-s lint:ts:fix lint:scss:fix",
    "lint:ts": "eslint \"./**/*.{ts,tsx,js,jsx,mjs}\"",
    "lint:ts:fix": "npm run lint:ts -- --fix",
    "lint:scss": "stylelint --ignore-path .gitignore \"./**/*.scss\"",
    "lint:scss:fix": "npm run lint:scss -- --fix",
    "upgrade-deps": "ncu --interactive --format group"
  },
  "lint-staged": {
    "./src/!(proto)/**/*.{ts,tsx,js,jsx,mjs}": [
      "npm run --silent lint:ts:fix"
    ],
    "./src/**/*.scss": [
      "npm run --silent lint:scss:fix"
    ]
  },
  "config": {
    "protocVersion": "36.2"
  },
  "dependencies": {
    "@babel/runtime": "8.0.7",
    "@blueprintjs/core": "6.21.0",
    "@blueprintjs/icons": "6.14.1",
    "@blueprintjs/select": "6.4.0",
    "@improbable-eng/grpc-web": "0.15.0",
    "@react-hook/resize-observer": "2.0.2",
    "@react-spring/web": "10.1.2",
    "@use-gesture/react": "10.3.1",
    "axios": "1.20.0",
    "classnames": "2.5.1",
    "core-js": "3.50.0",
    "d3": "7.9.0",
    "date-fns": "4.4.0",
    "decompress": "4.2.1",
    "google-protobuf": "3.21.4",
    "history": "5.3.0",
    "lodash": "4.18.1",
    "mobx": "7.0.6",
    "mobx-react": "10.0.2",
    "pluralize": "8.0.0",
    "prop-types": "15.8.1",
    "query-string": "9.5.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4",
    "react-window": "2.3.4",
    "url-parse": "1.5.10"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/plugin-transform-runtime": "7.29.7",
    "@babel/preset-env": "7.29.7",
    "@babel/preset-react": "7.29.7",
    "@blueprintjs/node-build-scripts": "10.0.1",
    "@eslint/compat": "2.1.1",
    "@protobuf-ts/plugin": "2.11.1",
    "@testing-library/react": "16.3.3",
    "@types/d3": "7.4.3",
    "@types/google-protobuf": "3.15.12",
    "@types/jest": "30.0.0",
    "@types/lodash": "4.17.26",
    "@types/object-hash": "3.0.6",
    "@types/pluralize": "0.0.33",
    "@types/prop-types": "15.7.15",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/route-parser": "0.1.7",
    "@types/url-parse": "1.4.11",
    "@typescript-eslint/eslint-plugin": "8.71.2",
    "@typescript-eslint/parser": "8.71.2",
    "ajv": "8.20.0",
    "autoprefixer": "10.6.1",
    "babel-jest": "30.5.2",
    "babel-loader": "10.1.1",
    "css-loader": "7.1.5",
    "dotenv-webpack": "9.0.0",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.7",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-unused-imports": "^4.4.1",
    "fs-extra": "11.4.1",
    "html-webpack-plugin": "5.6.8",
    "identity-obj-proxy": "3.0.0",
    "jest": "30.5.2",
    "jest-environment-jsdom": "30.5.2",
    "lint-staged": "17.6.0",
    "mini-css-extract-plugin": "2.10.2",
    "node-fetch": "3.3.2",
    "npm-check-updates": "23.1.1",
    "npm-run-all": "4.1.5",
    "patch-package": "8.0.1",
    "prettier": "3.9.10",
    "sass": "1.105.1",
    "sass-loader": "17.0.1",
    "servor": "4.0.2",
    "source-map-explorer": "2.5.3",
    "source-map-loader": "5.0.0",
    "stylelint": "17.16.0",
    "stylelint-config-css-modules": "4.6.0",
    "stylelint-config-prettier-scss": "1.0.0",
    "stylelint-config-standard-scss": "17.0.0",
    "stylelint-scss": "7.3.0",
    "svg-react-loader": "0.4.6",
    "ts-jest": "29.4.14",
    "ts-loader": "9.6.2",
    "ts-node": "10.9.2",
    "ts-protoc-gen": "0.15.0",
    "tsconfig-paths-webpack-plugin": "4.2.0",
    "typescript": "6.0.3",
    "webpack": "5.111.1",
    "webpack-cli": "7.2.3",
    "webpack-dev-server": "6.0.0"
  }
}
